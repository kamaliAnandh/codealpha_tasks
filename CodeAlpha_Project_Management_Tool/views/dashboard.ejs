<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Project Hub | Dashboard Hub</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        :root {

            --bg-main: #0b0f19;

            --bg-surface: #111827;

            --brand: #3b82f6;

            --text-main: #f3f4f6;

            --text-muted: #9ca3af;

            --border-color: rgba(255, 255, 255, 0.08);

        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-main); color: var(--text-main); padding: 40px; }

        .header-section { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto 40px auto; }

        .brand-title { font-size: 26px; font-weight: 800; }

        .brand-title span { color: var(--brand); }

        .right-meta { display: flex; align-items: center; gap: 15px; }

        

        .dashboard-layout-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; max-width: 1200px; margin: 0 auto; align-items: flex-start; }

        

        .creator-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; margin-bottom: 30px; }

        .creator-card h3 { margin-bottom: 16px; font-size: 18px; }

        .form-inline { display: flex; flex-direction: column; gap: 12px; }

        

        .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }

        .board-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; text-decoration: none; color: inherit; transition: all 0.2s; }

        .board-card:hover { border-color: var(--brand); transform: translateY(-2px); }

        .board-name { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: var(--brand); padding-right: 25px; }

        .board-desc { font-size: 14px; color: var(--text-muted); line-height: 1.5; }

        

        .team-panel-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; position: sticky; top: 40px; }

        .team-list-wrapper { margin-top: 15px; display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto; padding-right: 5px; }

        .member-badge { display: flex; align-items: center; gap: 10px; background: var(--bg-main); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border-color); font-size: 13.5px; }

        .member-avatar { background: var(--brand); color: #fff; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 11px; font-weight: 700; text-transform: uppercase; }



        .input-style { background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-main); padding: 12px 16px; border-radius: 10px; outline: none; font-size: 14px; width: 100%; }

        .input-style:focus { border-color: var(--brand); }

        .btn-style { background: var(--brand); color: white; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: opacity 0.2s; }

        .btn-style:hover { opacity: 0.9; }

        .logout-btn { text-decoration: none; font-size: 12px; color: #f87171; background: rgba(248, 113, 113, 0.1); padding: 6px 12px; border-radius: 6px; font-weight: 600; border: 1px solid rgba(248, 113, 113, 0.2); transition: all 0.2s; }

        .logout-btn:hover { background: #f87171; color: white; }

    </style>

</head>

<body>



    <div class="header-section">

        <div class="brand-title">🚀 <span>Project</span> Hub</div>

        <div class="right-meta">

            <div style="font-size: 14px; color: var(--text-muted);">Logged in as: <strong><%= user.username %></strong></div>

            <a href="/logout" class="logout-btn">Log Out</a>

        </div>

    </div>



    <div class="dashboard-layout-grid">

        <div>

            <div class="creator-card">

                <h3>Create New Project Board</h3>

                <form action="/create-board" method="POST" class="form-inline">

                    <input class="input-style" type="text" name="boardName" placeholder="Board Title (e.g., Mobile App Launch)" required>

                    <input class="input-style" type="text" name="boardDesc" placeholder="Brief project overview description..." required>

                    <button type="submit" class="btn-style" style="align-self: flex-start;">+ Create Board</button>

                </form>

            </div>



            <div class="grid-container">

                <% boards.forEach(function(board) { %>

                    <div style="position: relative;">

                        <a href="/board/<%= board.id %>" class="board-card" style="display: block; height: 100%;">

                            <div class="board-name">📁 <%= board.name %></div>

                            <div class="board-desc"><%= board.description %></div>

                        </a>



                        <form action="/delete-board/<%= board.id %>" method="POST" 

                              style="position: absolute; top: 15px; right: 15px; z-index: 10;"

                              onsubmit="return confirm('Are you sure you want to permanently delete this project board?');">

                            <button type="submit" 

                                    style="background: rgba(248, 113, 113, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); border-radius: 6px; width: 26px; height: 26px; font-size: 14px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;"

                                    onmouseover="this.style.background='#f87171'; this.style.color='white';"

                                    onmouseout="this.style.background='rgba(248, 113, 113, 0.15)'; this.style.color='#f87171';">

                                &times;

                            </button>

                        </form>

                    </div>

                <% }); %>

            </div>

        </div>



        <div class="team-panel-card">

            <h3 style="font-size: 17px; margin-bottom: 6px;">👥 Team Database</h3>

            <p style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 15px;">Add members to make them available for assignments.</p>

            

            <form action="/invite-member" method="POST" style="display: flex; flex-direction: column; gap: 10px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color);">

                <input class="input-style" type="email" name="memberEmail" placeholder="Enter colleague email..." required style="padding: 10px 12px; font-size: 13px;">

                <button type="submit" class="btn-style" style="padding: 10px; font-size: 13px;">+ Invite To Team</button>

            </form>



            <div class="team-list-wrapper">

                <% team.forEach(function(member) { %>

                    <div class="member-badge">

                        <div class="member-avatar"><%= member.username.substring(0,2) %></div>

                        <div>

                            <div style="font-weight: 700; color: #fff;">@<%= member.username %></div>

                            <div style="font-size: 11px; color: var(--text-muted);"><%= member.email %></div>

                        </div>

                    </div>

                <% }); %>

            </div>

        </div>

    </div>



</body>

</html> 