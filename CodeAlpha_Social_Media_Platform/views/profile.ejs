<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@<%= profileUser.username %> | Profile Space</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #0b0f19;
            --bg-surface: #111827;
            --bg-card: #1f2937;
            --brand: #3b82f6;
            --brand-glow: rgba(59, 130, 246, 0.15);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-pink: #ec4899;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', Arial, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .layout-container {
            display: flex;
            width: 100%;
            max-width: 1250px;
        }
        
        .sidebar {
            width: 260px;
            padding: 30px 20px;
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 10px;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .brand {
            font-size: 24px;
            color: var(--brand);
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 25px;
            padding-left: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-welcome-card {
            background: linear-gradient(135deg, var(--bg-surface), var(--bg-card));
            padding: 16px;
            border-radius: 14px;
            margin-bottom: 20px;
            font-size: 14px;
            border: 1px solid var(--border-color);
            line-height: 1.5;
        }

        .user-welcome-card strong {
            color: var(--brand);
            font-size: 15px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .nav-link:hover {
            background: var(--brand-glow);
            color: var(--brand);
            transform: translateX(4px);
        }
        
        .feed-container {
            flex: 1;
            border-right: 1px solid var(--border-color);
            padding: 30px;
            max-width: 650px;
        }

        .feed-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .back-btn {
            text-decoration: none;
            color: var(--brand);
            font-weight: bold;
            font-size: 22px;
            line-height: 1;
            transition: transform 0.2s;
        }

        .back-btn:hover {
            transform: scale(1.1);
        }

        .feed-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }
        
        .profile-hero {
            text-align: center;
            padding: 30px 20px;
            border-bottom: 1px solid var(--border-color);
            background: linear-gradient(to bottom, var(--bg-surface), rgba(17,24,39,0.5));
            border-radius: 16px;
            margin-bottom: 25px;
            border: 1px solid var(--border-color);
        }

        .avatar-huge {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--brand), #1d4ed8);
            color: white;
            border-radius: 50%;
            font-size: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            margin: 0 auto 14px auto;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }

        .profile-handle {
            font-weight: 800;
            font-size: 20px;
            color: var(--text-main);
            letter-spacing: -0.5px;
        }

        .metrics-row {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 14px;
            color: var(--text-muted);
            font-size: 14px;
        }

        .metrics-row strong {
            color: var(--text-main);
        }

        .timeline-section-title {
            font-size: 16px;
            font-weight: 800;
            margin: 25px 0 15px 0;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .post-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .post-header-inner {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .avatar-circle-sm {
            width: 38px;
            height: 38px;
            background: var(--brand);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .author-info-block {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .author-name-text {
            font-weight: 700;
            color: var(--text-main);
            font-size: 15px;
        }

        .author-role-badge {
            background: rgba(255, 255, 255, 0.06);
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 6px;
            color: var(--text-muted);
            width: max-content;
        }

        .post-content {
            font-size: 15px;
            margin: 12px 0;
            line-height: 1.6;
            color: #e5e7eb;
        }

        .actions-bar {
            display: flex;
            gap: 24px;
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
        }

        .btn-action-form button {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-action-form button:hover {
            color: var(--accent-pink);
        }

        .replies-counter {
            color: var(--text-muted);
            font-size: 13px;
            font-weight: 500;
        }
        
        .comment-box {
            background: rgba(255, 255, 255, 0.03);
            padding: 16px;
            border-radius: 12px;
            margin-top: 14px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .comment-item {
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 13.5px;
        }

        .comment-item strong {
            color: var(--brand);
        }

        .comment-input-form {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }

        .comment-input-form input {
            width: 100%;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px 14px;
            border-radius: 10px;
            outline: none;
            font-size: 13px;
        }
        
        .right-sidebar {
            width: 300px;
            padding: 30px;
        }

        .guidelines-card {
            background: var(--bg-surface);
            padding: 20px;
            border-radius: 16px;
            line-height: 1.6;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            font-size: 13.5px;
        }

        .guidelines-card h4 {
            margin-bottom: 10px;
            color: var(--text-main);
            font-size: 15px;
            font-weight: 700;
        }
        
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            padding: 24px;
            border-radius: 16px;
            width: 90%;
            max-width: 380px;
        }

        .modal-header {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 12px;
        }

        .modal-close-btn {
            cursor: pointer;
            font-size: 22px;
            color: var(--text-muted);
        }

        .modal-body-content {
            font-size: 13.5px;
            color: var(--text-main);
            background: rgba(255,255,255,0.03);
            padding: 12px;
            border-radius: 10px;
            margin-top: 10px;
            border: 1px solid var(--border-color);
        }
    </style>
</head>
<body>

<div class="layout-container">
    
    <div class="sidebar">
        <div class="brand">🚀 SocialAlpha</div>
        <div class="user-welcome-card">
            Logged in as:<br><strong>@<%= user.username %></strong>
            <br><a href="/" style="color: var(--accent-pink); font-size:12px; text-decoration:none; font-weight:600; display:inline-block; margin-top:6px;">Sign Out</a>
        </div>
        
        <a href="/index" class="nav-link">🏠 Home Feed</a>
        <a href="/profile/<%= user.username %>" class="nav-link" style="color: var(--brand); background: var(--brand-glow);">👤 My Profile</a>
        <div class="nav-link" onclick="toggleModal('notifModal')">🔔 Notifications</div>
        <div class="nav-link" onclick="toggleModal('msgModal')">✉️ Messages</div>
    </div>
    
    <div class="feed-container">
        <div class="feed-header">
            <a href="/index" class="back-btn">←</a>
            <div class="feed-title">Profile Space</div>
        </div>
        
        <div class="profile-hero">
            <div class="avatar-huge"><%= profileUser.username.charAt(0).toUpperCase() %></div>
            <div class="profile-handle">@<%= profileUser.username %></div>
            
            <div class="metrics-row">
                <span><strong><%= profileUser.followingCount %></strong> Following</span>
                <span><strong><%= profileUser.followersCount %></strong> Followers</span>
            </div>
        </div>
        
        <div class="timeline-section-title">Timeline Updates</div>
        
        <% if (posts.length === 0) { %>
            <div style="color: var(--text-muted); font-style: italic; padding: 40px; text-align: center; background: var(--bg-surface); border-radius: 16px; border: 1px solid var(--border-color);">
                No timeline updates published by this handle yet.
            </div>
        <% } else { %>
            <% posts.forEach(function(post) { %>
                <div class="post-card">
                    <div class="post-header-inner">
                        <div class="avatar-circle-sm"><%= post.author.charAt(0).toUpperCase() %></div>
                        <div class="author-info-block">
                            <span class="author-name-text">@<%= post.author %></span>
                            <span class="author-role-badge"><%= post.role %></span>
                        </div>
                    </div>
                    
                    <div class="post-content"><%= post.content %></div>
                    
                    <div class="actions-bar">
                        <form action="/like-post" method="POST" class="btn-action-form">
                            <input type="hidden" name="postId" value="<%= post.id %>">
                            <button type="submit">❤️ <%= post.likes %></button>
                        </form>
                        <span class="replies-counter">💬 <%= post.comments.length %> Replies</span>
                    </div>
                    
                    <div class="comment-box">
                        <% post.comments.forEach(function(comment) { %>
                            <div class="comment-item">
                                <strong>@<%= comment.author %>:</strong> <%= comment.text %>
                            </div>
                        <% }); %>
                        
                        <form action="/comment-post" method="POST" class="comment-input-form">
                            <input type="hidden" name="postId" value="<%= post.id %>">
                            <input type="text" name="commentText" placeholder="Post your response reply..." required>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
    
    <div class="right-sidebar">
        <div class="guidelines-card">
            <h4>Platform Guidelines</h4>
            Track timeline details and active interactions directly inside your dashboard window.
        </div>
    </div>
</div>

<div id="notifModal" class="modal-overlay" onclick="closeModalOutside(event, 'notifModal')">
    <div class="modal-card">
        <div class="modal-header">
            <span>Notifications</span>
            <span class="modal-close-btn" onclick="toggleModal('notifModal')">×</span>
        </div>
        <% notifications.forEach(function(notif) { %>
            <div class="modal-body-content">
                ❤️ <strong><%= notif.message %></strong>
                <div style="font-size:11px; color: var(--text-muted); margin-top:4px;"><%= notif.timestamp %></div>
            </div>
        <% }); %>
    </div>
</div>

<div id="msgModal" class="modal-overlay" onclick="closeModalOutside(event, 'msgModal')">
    <div class="modal-card">
        <div class="modal-header">
            <span>Direct Messages</span>
            <span class="modal-close-btn" onclick="toggleModal('msgModal')">×</span>
        </div>
        <% messages.forEach(function(msg) { %>
            <div class="modal-body-content">
                <strong>@<%= msg.author %></strong>
                <div style="margin-top:4px;"><%= msg.message %></div>
                <div style="font-size:11px; color: var(--text-muted); margin-top:4px;"><%= msg.timestamp %></div>
            </div>
        <% }); %>
    </div>
</div>

<script>
    function toggleModal(id) {
        const modal = document.getElementById(id);
        modal.style.display = (modal.style.display === 'flex') ? 'none' : 'flex';
    }
    function closeModalOutside(event, id) {
        if (event.target.id === id) {
            toggleModal(id);
        }
    }
</script>

</body>
</html>