<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Access Account | CodeAlpha Elite</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --primary: #3498db; 
            --dark-navy: #1a2a3a; 
            --accent-green: #2ecc71;
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg-gradient) !important;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Consistent Header */
        header { 
            background: linear-gradient(90deg, #1a2a3a 0%, #2c3e50 100%) !important;
            padding: 1.2rem 5%; 
            color: white; 
            display: flex; 
            justify-content: space-between; 
            align-items: center;
            border-bottom: 3px solid var(--primary);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .auth-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .auth-container {
            display: flex;
            gap: 30px;
            width: 100%;
            max-width: 950px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Modern Auth Cards */
        .auth-card {
            background: white !important;
            flex: 1;
            min-width: 320px;
            padding: 45px;
            border-radius: 30px !important;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            transition: all 0.4s ease;
            text-align: center;
            border-bottom: 6px solid transparent;
        }

        .auth-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
        }

        .auth-card h2 {
            color: var(--dark-navy);
            font-weight: 800;
            font-size: 2rem;
            margin-bottom: 35px;
            letter-spacing: -1px;
        }

        /* Input Wrapper for Eye Button alignment */
        .password-wrapper {
            position: relative;
            width: 100%;
        }

        /* Input Styling */
        .input-box {
            width: 100%;
            padding: 16px 20px;
            margin-bottom: 20px;
            border-radius: 15px;
            border: 2px solid #eee;
            font-family: 'Poppins', sans-serif;
            font-size: 0.95rem;
            outline: none;
            transition: 0.3s;
            box-sizing: border-box;
        }

        /* Prevent button overlap text padding adjustment */
        .input-box-password {
            padding-right: 50px;
        }

        .input-box:focus {
            border-color: var(--primary);
            background: #f0f7ff;
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.1);
        }

        /* Eye Icon Style button */
        .eye-toggle-btn {
            position: absolute;
            right: 15px;
            top: 25px;
            transform: translateY(-50%);
            cursor: pointer;
            user-select: none;
            font-size: 1.2rem;
            opacity: 0.6;
            transition: opacity 0.2s;
        }

        .eye-toggle-btn:hover {
            opacity: 1;
        }

        /* Button Styling */
        .btn {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-register {
            background: var(--dark-navy);
            color: white;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .btn-register:hover {
            background: #000;
            transform: scale(1.02);
        }

        .btn-login {
            background: var(--primary);
            color: white;
            box-shadow: 0 10px 20px rgba(52, 152, 219, 0.3);
        }

        .btn-login:hover {
            background: #2980b9;
            transform: scale(1.02);
        }

        footer {
            text-align: center;
            padding: 30px;
            color: var(--dark-navy);
            font-weight: 600;
            opacity: 0.7;
        }
    </style>
</head>
<body>

    <header>
        <h2 style="margin:0; letter-spacing: 3px; font-weight: 800;">CODE<span style="color:var(--primary)">ALPHA</span></h2>
        <nav>
            <a href="/" style="color:white; text-decoration:none; font-weight: 600; font-size: 0.9rem;">← Back to Shop</a>
        </nav>
    </header>

    <div class="auth-wrapper">
        <div class="auth-container">
            
            <div class="auth-card">
                <h2>Join Us</h2>
                <form action="/register" method="POST">
                    <input type="text" name="username" placeholder="Choose Username" class="input-box" required>
                    <div class="password-wrapper">
                        <input type="password" id="registerPassword" name="password" placeholder="Choose Password" class="input-box input-box-password" required>
                        <span id="toggleRegisterPassword" class="eye-toggle-btn">👁️</span>
                    </div>
                    <button type="submit" class="btn btn-register">Create Account</button>
                </form>
                <p style="margin-top: 20px; color: #7f8c8d; font-size: 0.85rem;">Become a member for exclusive tech deals.</p>
            </div>

            <div class="auth-card" style="border-bottom-color: var(--primary);">
                <h2>Welcome Back</h2>
                <form action="/login" method="POST">
                    <input type="text" name="username" placeholder="Username" class="input-box" required>
                    <div class="password-wrapper">
                        <input type="password" id="loginPassword" name="password" placeholder="Password" class="input-box input-box-password" required>
                        <span id="toggleLoginPassword" class="eye-toggle-btn">👁️</span>
                    </div>
                    <button type="submit" class="btn btn-login">Login to Store</button>
                </form>
                <p style="margin-top: 20px; color: #7f8c8d; font-size: 0.85rem;">Access your cart and wishlist.</p>
            </div>

        </div>
    </div>

    <footer>
        &copy; 2026 CodeAlpha Internship | Secure Authentication System
    </footer>

    <script>
        function setupPasswordToggle(toggleId, inputId) {
            const toggleElement = document.getElementById(toggleId);
            const inputElement = document.getElementById(inputId);

            toggleElement.addEventListener('click', function () {
                // Toggle type attribute
                const isPassword = inputElement.getAttribute('type') === 'password';
                inputElement.setAttribute('type', isPassword ? 'text' : 'password');
                
                // Toggle eye visibility emoji look
                this.textContent = isPassword ? '🙈' : '👁️';
            });
        }

        // Apply toggle settings to both Register and Login layout cards
        setupPasswordToggle('toggleRegisterPassword', 'registerPassword');
        setupPasswordToggle('toggleLoginPassword', 'loginPassword');
    </script>

</body>
</html>