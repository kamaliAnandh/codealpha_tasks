<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Wishlist | Tech Store</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
</head>
<body style="font-family: 'Poppins', sans-serif; background: #f8f9fa; margin: 0; padding: 40px;">
    <div style="max-width: 1000px; margin: 0 auto;">
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
            <h1 style="color: #2c3e50; margin: 0;">My Favorites ❤️</h1>
            <a href="/" style="text-decoration: none; background: #3498db; color: white; padding: 10px 20px; border-radius: 10px; font-weight: 600;">Back to Shop</a>
        </header>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px;">
            <% if (products.length === 0) { %>
                <div style="grid-column: 1/-1; text-align: center; padding: 100px; background: white; border-radius: 20px;">
                    <h3 style="color: #bdc3c7;">Your wishlist is empty.</h3>
                    <p style="color: #7f8c8d;">Add some items to see them here!</p>
                </div>
            <% } else { %>
                <% products.forEach(product => { %>
                    <div style="background: white; padding: 25px; border-radius: 20px; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.05);">
                        <img src="<%= product.img %>" style="width: 100%; height: 150px; object-fit: contain; margin-bottom: 15px;">
                        <h3 style="color: #2c3e50;"><%= product.name %></h3>
                        <p style="color: #27ae60; font-weight: bold;">$<%= product.price %></p>
                        <form action="/wishlist/toggle" method="POST">
                            <input type="hidden" name="productId" value="<%= product.id %>">
                            <button type="submit" style="width: 100%; background: #fdf2f2; color: #e74c3c; border: 1px solid #fbd5d5; padding: 10px; border-radius: 10px; cursor: pointer; font-weight: 600;">Remove ❤️</button>
                        </form>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>