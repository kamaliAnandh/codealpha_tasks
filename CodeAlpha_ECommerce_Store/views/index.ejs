<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CodeAlpha | Elite Tech Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --primary: #3498db; 
            --accent: #2ecc71; 
            --dark-navy: #1a2a3a; 
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }
        
        body { 
            background: var(--bg-gradient) !important; 
            margin: 0; 
            font-family: 'Poppins', sans-serif; 
            min-height: 100vh;
        }
        
        /* Premium Header with Gradient */
        header { 
            background: linear-gradient(90deg, #1a2a3a 0%, #2c3e50 100%) !important;
            padding: 1.2rem 5%; 
            color: white; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            position: sticky; 
            top: 0; 
            z-index: 1000;
            border-bottom: 3px solid var(--primary);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        /* Hero Text Styling */
        h1 {
            color: var(--dark-navy);
            font-weight: 800;
            font-size: 3rem;
            margin: 0;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.05);
        }

        /* Floating Product Cards */
        .product-card {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
            border: none !important;
            background: white !important;
            position: relative; 
            overflow: hidden;
            border-radius: 25px !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        .product-card:hover {
            transform: translateY(-15px) !important;
            box-shadow: 0 25px 50px rgba(52, 152, 219, 0.2) !important;
            border-bottom: 5px solid var(--primary) !important;
        }

        /* Image Zoom Animation */
        .product-card img { 
            transition: transform 0.5s ease; 
            position: relative;
            z-index: 1;
        }
        .product-card:hover img { transform: scale(1.1); }

        /* Wishlist Heart Positioning */
        .wishlist-form {
            position: absolute;
            top: 15px;
            right: 15px;
            z-index: 10;
        }
        .heart-btn {
            background: none; border: none; font-size: 1.7rem; cursor: pointer;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
            transition: 0.2s;
        }
        .heart-btn:hover { transform: scale(1.2); }

        /* Vibrant Price Bubble */
        .price-bubble {
            background: #e8f8f0;
            color: var(--accent) !important;
            padding: 8px 20px;
            border-radius: 50px;
            display: inline-block;
            font-weight: 800;
            font-size: 1.5rem !important;
            margin-bottom: 20px;
        }

        /* Colorful Solid Buttons */
        .btn-details {
            background: var(--primary) !important;
            color: white !important;
            padding: 14px;
            text-decoration: none;
            font-weight: 700;
            border-radius: 15px;
            display: block;
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
            transition: 0.3s;
            text-transform: uppercase;
            font-size: 0.85rem;
        }
        .btn-details:hover { background: #2980b9 !important; transform: scale(1.03); }

        .btn-cart-solid {
            background: var(--dark-navy) !important;
            color: white !important;
            width: 100%;
            padding: 14px;
            border: none;
            cursor: pointer;
            font-weight: 700;
            border-radius: 15px;
            transition: 0.3s;
            text-transform: uppercase;
            font-size: 0.85rem;
        }
        .btn-cart-solid:hover { background: #000 !important; }

        /* Search & Filters */
        .search-input {
            padding: 16px 25px; width: 350px; border-radius: 40px; border: 2px solid #ddd;
            transition: 0.4s; font-size: 1rem; outline: none;
        }
        .search-input:focus { width: 450px; border-color: var(--primary); box-shadow: 0 10px 20px rgba(52,152,219,0.1); }

        .cat-pill {
            padding: 10px 25px; border-radius: 30px; text-decoration: none; font-weight: 700;
            transition: 0.3s; font-size: 0.85rem; border: 2px solid var(--primary);
        }
    </style>
</head>
<body>

    <header>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem;">
            <span>📍</span>
            <span>Deliver to: <strong style="color: white;">Coimbatore, TN</strong></span>
        </div>
        <h2 style="margin:0; letter-spacing: 3px; font-weight: 800;">CODE<span style="color:#3498db;">ALPHA</span></h2>
        <nav style="display: flex; gap: 20px; align-items: center;">
            <a href="/" style="color:white; text-decoration:none; font-weight: 600;">Home</a>
            <a href="/wishlist" style="color:white; text-decoration:none;">Wishlist ❤️</a>
            <a href="/cart" style="color:white; text-decoration:none;">Cart 🛒</a>
            <% if (user) { %>
                <div style="background:var(--primary); padding:6px 15px; border-radius:20px; display:flex; gap:10px; align-items:center;">
                    <span style="font-weight:600; font-size:0.85rem;">👤 <%= user %></span>
                    <a href="/logout" style="color:white; text-decoration:none; font-size:0.7rem; font-weight: bold;">Logout</a>
                </div>
            <% } else { %>
                <a href="/login" style="background: white; color: var(--dark-navy); padding: 8px 25px; border-radius: 10px; font-weight: 700; text-decoration: none;">Login</a>
            <% } %>
        </nav>
    </header>

    <div style="text-align: center; padding: 60px 0 40px 0;">
        <h1>The Future of Tech</h1>
        <p style="color: #555; font-size: 1.2rem; font-weight: 500;">Premium gadgets curated for modern innovators.</p>
        
        <form action="/" method="GET" style="margin: 30px 0;">
            <input type="text" name="search" placeholder="Search for tech..." class="search-input">
            <button type="submit" style="background:var(--primary); color:white; border:none; padding:16px 40px; border-radius:40px; cursor:pointer; font-weight:700; margin-left: -60px;">Search</button>
        </form>
    </div>

    <div style="display:flex; justify-content:center; gap:12px; margin-bottom:50px;">
        <% ['all', 'electronics', 'toys', 'home', 'fashion'].forEach(cat => { %>
            <a href="<%= cat === 'all' ? '/' : '/?category=' + cat %>" class="cat-pill"
               style="background: <%= selectedCategory === cat ? '#3498db' : '#fff' %>; 
                      color: <%= selectedCategory === cat ? '#fff' : '#3498db' %>;">
               <%= cat.toUpperCase() %>
            </a>
        <% }) %>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:40px; padding:0 8% 100px 8%;">
        <% products.forEach(product => { %>
            <div class="product-card" style="padding:35px; text-align:center;">
                
                <form action="/wishlist/toggle" method="POST" class="wishlist-form">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <button type="submit" class="heart-btn">
                        <%= wishlist.includes(product.id) ? '❤️' : '🤍' %>
                    </button>
                </form>

                <img src="<%= product.img %>" style="width:100%; height:180px; object-fit:contain; margin-bottom:25px;">
                <h3 style="color:var(--dark-navy); font-weight:700; margin-bottom: 15px; font-size: 1.25rem;"><%= product.name %></h3>
                
                <div class="price-bubble">$<%= product.price %></div>
                
                <div style="display:flex; flex-direction:column; gap:12px;">
                    <a href="/product/<%= product.id %>" class="btn-details">Explore Details</a>
                    
                    <form action="/add-to-cart" method="POST" style="padding:0; background:none; box-shadow:none;">
                        <input type="hidden" name="productId" value="<%= product.id %>">
                        <button type="submit" class="btn-cart-solid">Add to Cart 🛒</button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>

    <footer style="text-align:center; padding:60px; color:var(--dark-navy); font-weight: 600;">
        <p>&copy; 2026 CodeAlpha Internship | E-Commerce Vibrant Project</p>
    </footer>

</body>
</html>